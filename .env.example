# =============================================================================
# HIET Digital Campus — Environment Configuration Template
# Himachal Institute of Engineering & Technology, Shahpur
# =============================================================================

# Client-Side Supabase Configuration
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here
VITE_ENABLE_DEMO_LOGIN=true

# AI Campus Phase 1 Feature Flag (Frontend-safe)
VITE_AI_FEATURES_ENABLED=true

# Server-Side / CLI Administration (Never expose in frontend)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
DEMO_SEED_ENABLED=false

# Server-Only AI Provider Configuration (Supabase Secrets, NEVER prefix with VITE_)
AI_PROVIDER=openai
AI_MODEL=gpt-4.1-mini
OPENAI_API_KEY=your-openai-api-key-here
GEMINI_API_KEY=your-gemini-api-key-here
