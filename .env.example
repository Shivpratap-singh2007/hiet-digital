# =============================================================================
# HIET Digital Campus — Environment Configuration Template
# Himachal Institute of Engineering & Technology, Shahpur
# =============================================================================

# -----------------------------------------------------------------------------
# 1. CLIENT-SIDE VARIABLES (Exposed in Browser via VITE_ prefix)
# -----------------------------------------------------------------------------
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here
VITE_APP_ENV=development

# Authentication & Demo Controls
# (Set both to false in Staging and Production)
VITE_ENABLE_DEMO_LOGIN=true
VITE_DEMO_MODE=false

# Attendance Development Diagnostics & Simulation
# (Set to false in Staging and Production)
VITE_ATTENDANCE_TEST_MODE=false

# AI Frontend Feature Toggles
VITE_AI_FEATURES_ENABLED=true
VITE_AI_FEATURE_PREVIEW=false
VITE_AI_PHASE_2_ENABLED=false
VITE_ZONE_PRESENCE_ENABLED=false
VITE_OCCUPANCY_ANALYTICS_ENABLED=false
VITE_KNOWLEDGE_SEARCH_ENABLED=true
VITE_BLE_PILOT_ENABLED=false

# Web Push Notification Public Key (Client-side service worker registration)
VITE_VAPID_PUBLIC_KEY=

# -----------------------------------------------------------------------------
# 2. SERVER-SIDE SECRETS (SUPABASE SECRETS / EDGE FUNCTIONS — NEVER EXPOSE TO VITE_)
# Set these using: supabase secrets set KEY=VALUE
# -----------------------------------------------------------------------------

# Supabase Admin Operations (CLI / DB Seed scripts only)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
DEMO_SEED_ENABLED=false

# Email Notification Provider (Resend)
EMAIL_PROVIDER=resend
RESEND_API_KEY=re_your_api_key_here
EMAIL_FROM=HIET Digital Campus <noreply@notifications.hiet.ac.in>

# Server-Side AI Provider Configuration
# Supported AI_PROVIDER: gemini | openai
AI_PROVIDER=gemini
AI_MODEL=gemini-1.5-flash
GOOGLE_GENERATIVE_AI_API_KEY=your-google-ai-api-key-here
GEMINI_API_KEY=your-google-ai-api-key-here
OPENAI_API_KEY=your-openai-api-key-here
AI_FEATURES_ENABLED=true

# Web Push Notification Private Key (Stored in Server Secrets)
VAPID_PRIVATE_KEY=your-vapid-private-key-here

# Server-Side Phase 2 Edge Runtime Flags
AI_PHASE_2_ENABLED=false
ZONE_PRESENCE_ENABLED=false
OCCUPANCY_ANALYTICS_ENABLED=false
KNOWLEDGE_SEARCH_ENABLED=true
BLE_PILOT_ENABLED=false
