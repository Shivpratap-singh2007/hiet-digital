# =============================================================================
# HIET Digital Campus — Environment Configuration Template
# Himachal Institute of Engineering & Technology, Shahpur
# =============================================================================

# Client-Side Supabase Configuration
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here
VITE_ENABLE_DEMO_LOGIN=true
VITE_APP_ENV=development

# AI Campus Features & Coming Soon Preview Flags
VITE_AI_FEATURES_ENABLED=false
VITE_AI_FEATURE_PREVIEW=false

# AI Campus Phase 2 Feature Flags (Frontend-safe)
VITE_AI_PHASE_2_ENABLED=false
VITE_ZONE_PRESENCE_ENABLED=false
VITE_OCCUPANCY_ANALYTICS_ENABLED=false
VITE_KNOWLEDGE_SEARCH_ENABLED=false
VITE_BLE_PILOT_ENABLED=false

# Server-Side Feature Flags (Supabase Edge runtime / Secrets)
AI_PHASE_2_ENABLED=false
ZONE_PRESENCE_ENABLED=false
OCCUPANCY_ANALYTICS_ENABLED=false
KNOWLEDGE_SEARCH_ENABLED=false
BLE_PILOT_ENABLED=false

# Server-Side / CLI Administration (Never expose in frontend)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
DEMO_SEED_ENABLED=false

# Server-Only AI Provider Configuration (Supabase Secrets, NEVER prefix with VITE_)
AI_PROVIDER=openai
AI_MODEL=gpt-4.1-mini
OPENAI_API_KEY=your-openai-api-key-here
GEMINI_API_KEY=your-gemini-api-key-here
